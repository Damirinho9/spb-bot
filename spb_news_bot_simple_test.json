      "name": "Fetch RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 100]
    },
    {
      "parameters": {
        "jsCode": "// Парсим RSS и берём первую новость\nconst xml = $input.first().json.data || '';\n\nconst itemRegex = /<item[^>]*>([\\s\\S]*?)<\\/item>/i;\nconst match = xml.match(itemRegex);\n\nif (!match) {\n  return [{json: {error: 'No items found', rawLength: xml.length}}];\n}\n\nconst itemXml = match[1];\n\nconst getTag = (tag) => {\n  const regex = new RegExp(`<${tag}[^>]*><!\\\\[CDATA\\\\[([\\\\s\\\\S]*?)\\\\]\\\\]><\\\\/${tag}>|<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`, 'i');\n  const m = itemXml.match(regex);\n  return m ? (m[1] || m[2] || '').trim() : '';\n};\n\nconst title = getTag('title');\nlet description = getTag('description');\ndescription = description.replace(/<[^>]*>/g, '').substring(0, 600);\n\nreturn [{json: {\n  title: title || 'Без заголовка',\n  description: description || 'Без описания'\n}}];"
      },
      "id": "parse-rss",
      "name": "Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 100]
    },
    {
      "parameters": {
        "modelId": {"__rl": true, "mode": "list", "value": "gpt-4o-mini"},
        "messages": {
          "values": [
            {
              "content": "=Создай короткий пост для Telegram (макс 500 символов) о бесплатном событии в Петербурге. Используй эмодзи. Формат: название, дата/место, краткое описание.\n\nИсходные данные:\nЗаголовок: {{ $json.title }}\nОписание: {{ $json.description }}"
            }
          ]
        },
        "options": {"maxTokens": 500, "temperature": 0.7}
      },
      "id": "openai",
      "name": "GPT",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [660, 100],
      "credentials": {
        "openAiApi": {
          "id": "SHcnJYZh5AvmqkWu",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet text = '';\n\nif (input.message?.content) text = input.message.content;\nelse if (input.text) text = input.text;\nelse text = JSON.stringify(input);\n\nreturn [{json: {post: text}}];"
      },
