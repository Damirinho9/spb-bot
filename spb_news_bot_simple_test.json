{
  "name": "SPB News Bot - SIMPLE TEST",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "test-post",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 100],
      "webhookId": "test-post"
    },
    {
      "parameters": {
        "url": "https://t.me/s/freepeterburg",
        "options": {
          "response": {"response": {"responseFormat": "text"}},
          "timeout": 15000
        }
      },
      "id": "fetch-telegram",
      "name": "Fetch Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 100],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Парсим Telegram и берём первый пост\nconst input = $input.first().json;\n\nif (input.error || !input.data) {\n  return [{json: {error: 'Ошибка загрузки', details: input.error}}];\n}\n\nconst html = input.data;\n\n// Ищем текст постов\nconst textMatch = html.match(/<div[^>]*class=\"[^\"]*tgme_widget_message_text[^\"]*\"[^>]*>([\\s\\S]*?)<\\/div>/i);\n\nif (!textMatch) {\n  return [{json: {error: 'Посты не найдены', htmlLength: html.length}}];\n}\n\nlet text = textMatch[1]\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<[^>]*>/g, '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .trim();\n\nreturn [{json: {\n  title: text.substring(0, 100),\n  description: text.substring(0, 800)\n}}];"
      },
      "id": "parse",
      "name": "Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 100]
    },
    {
      "parameters": {
        "modelId": {"__rl": true, "mode": "list", "value": "gpt-4o-mini"},
        "messages": {
          "values": [
            {
              "content": "=Создай короткий пост для Telegram (макс 500 символов) о бесплатном событии в Петербурге.\n\nПравила:\n1. Используй эмодзи для категории в начале\n2. Структура: название, дата/место, описание\n3. Убери рекламу и ссылки\n\nИсходные данные:\n{{ $json.description }}"
            }
          ]
        },
        "options": {"maxTokens": 500, "temperature": 0.7}
      },
      "id": "openai",
      "name": "GPT",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [660, 100],
      "credentials": {
        "openAiApi": {
          "id": "ft9ZQPEC4h3cWRpc",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet text = '';\n\nif (input.message?.content) text = input.message.content;\nelse if (input.text) text = input.text;\nelse text = JSON.stringify(input);\n\n// Убираем markdown\ntext = text.replace(/```[\\s\\S]*?```/g, '').trim();\n\nreturn [{json: {post: text}}];"
      },
      "id": "extract",
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 100]
    },
    {
      "parameters": {
        "chatId": "@kontentzavodn8npro",
        "text": "={{ $json.post }}",
        "additionalFields": {"parse_mode": "HTML"}
      },
      "id": "telegram",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1100, 100],
      "credentials": {
        "telegramApi": {
          "id": "y6LOi4D9Lh9X3XHL",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [{"name": "result", "value": "=OK! Пост отправлен: {{ $json.post.substring(0, 100) }}..."}]
        },
        "options": {}
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 100]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Fetch Telegram", "type": "main", "index": 0}]]
