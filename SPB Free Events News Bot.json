      "id": "20d37c2e-e60f-44c5-94aa-373008b6749d",
      "name": "Объединяем новости",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1792,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Создаём hash для проверки дублей\nconst crypto = require('crypto');\n\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const hashInput = (data.title || '') + (data.pubDate || '');\n  const hash = crypto.createHash('md5').update(hashInput).digest('hex').substring(0, 12);\n  \n  result.push({\n    json: {\n      ...data,\n      content_hash: hash\n    }\n  });\n}\n\nreturn result;"
      },
