    {
      "parameters": {
        "jsCode": "// Фильтруем дубли\nconst news = $('Создаём hash').all();\nconst published = $('Читаем опубликованные').all();\n\nconst publishedHashes = new Set(\n  published.map(p => p.json.content_hash).filter(Boolean)\n);\n\nconst newItems = news.filter(item => \n  !publishedHashes.has(item.json.content_hash)\n);\n\n// Берём только 1 новость для публикации\nif (newItems.length === 0) {\n  return [];\n}\n\nreturn [newItems[0]];"
      },
