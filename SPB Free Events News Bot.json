      "id": "4107985d-ea36-4bcc-a781-05aac60ac98b",
      "name": "Fetch RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        -176
      ]
    },
    {
      "parameters": {
        "jsCode": "// Парсим RSS XML\nconst xml = $input.first().json.data;\nconst items = [];\n\n// Простой парсинг RSS\nconst itemRegex = /<item[^>]*>([\\s\\S]*?)<\\/item>/gi;\nlet match;\n\nwhile ((match = itemRegex.exec(xml)) !== null) {\n  const itemXml = match[1];\n  \n  const getTag = (tag) => {\n    const regex = new RegExp(`<${tag}[^>]*><!\\\\[CDATA\\\\[([\\\\s\\\\S]*?)\\\\]\\\\]><\\\\/${tag}>|<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`, 'i');\n    const m = itemXml.match(regex);\n    return m ? (m[1] || m[2] || '').trim() : '';\n  };\n  \n  const title = getTag('title');\n  const link = getTag('link');\n  const description = getTag('description');\n  const pubDate = getTag('pubDate');\n  \n  // Ищем медиа\n  let mediaUrl = '';\n  const enclosureMatch = itemXml.match(/<enclosure[^>]*url=[\"']([^\"']+)[\"'][^>]*>/i);\n  if (enclosureMatch) mediaUrl = enclosureMatch[1];\n  \n  const mediaMatch = itemXml.match(/<media:content[^>]*url=[\"']([^\"']+)[\"'][^>]*>/i);\n  if (!mediaUrl && mediaMatch) mediaUrl = mediaMatch[1];\n  \n  const imgMatch = description.match(/<img[^>]*src=[\"']([^\"']+)[\"'][^>]*>/i);\n  if (!mediaUrl && imgMatch) mediaUrl = imgMatch[1];\n  \n  if (title) {\n    items.push({\n      title,\n      link,\n      description: description.replace(/<[^>]*>/g, '').substring(0, 1000),\n      pubDate,\n      mediaUrl,\n      source_id: $('Читаем источники').first().json.id,\n      source_name: $('Читаем источники').first().json.name\n    });\n  }\n}\n\n// Берём только последние 5 новостей\nreturn items.slice(0, 5).map(item => ({ json: item }));"
      },
      "id": "2d65b1cd-b028-472c-95a4-3fa1ea503c2d",
      "name": "Parse RSS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -176
      ]
    },
