    {
      "parameters": {
        "jsCode": "// Собираем данные для LLM\nconst news = $('Убираем дубли').first().json;\nconst settingsRows = $('Читаем настройки').all();\n\n// Преобразуем настройки в объект\nconst settings = {};\nfor (const row of settingsRows) {\n  settings[row.json.key] = row.json.value;\n}\n\nconst prompt = settings.prompt || 'Создай пост для Telegram';\nconst maxLength = settings.max_post_length || 1000;\n\nconst userMessage = `${prompt}\n\n---\nНовость для обработки:\n\nЗаголовок: ${news.title}\n\nОписание: ${news.description}\n\nДата: ${news.pubDate}\n\nИсточник: ${news.source_name}\n\n---\nМаксимальная длина поста: ${maxLength} символов`;\n\nreturn [{\n  json: {\n    ...news,\n    settings,\n    userMessage\n  }\n}];"
      },
