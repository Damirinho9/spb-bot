      "id": "eda756e6-64f4-4dff-b1e6-c791b597b112",
      "name": "Fetch Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Парсим Telegram widget страницу\nconst html = $input.first().json.data;\nconst items = [];\n\n// Ищем посты\nconst postRegex = /<div class=\"tgme_widget_message_wrap[^>]*>([\\s\\S]*?)<\\/div>\\s*<\\/div>\\s*<\\/div>/gi;\nlet match;\n\nwhile ((match = postRegex.exec(html)) !== null && items.length < 5) {\n  const postHtml = match[1];\n  \n  // Текст поста\n  const textMatch = postHtml.match(/<div class=\"tgme_widget_message_text[^>]*>([\\s\\S]*?)<\\/div>/i);\n  const text = textMatch ? textMatch[1].replace(/<[^>]*>/g, '').trim() : '';\n  \n  // Дата\n  const dateMatch = postHtml.match(/datetime=[\"']([^\"']+)[\"']/i);\n  const pubDate = dateMatch ? dateMatch[1] : '';\n  \n  // Ссылка на пост\n  const linkMatch = postHtml.match(/data-post=[\"']([^\"']+)[\"']/i);\n  const link = linkMatch ? `https://t.me/${linkMatch[1]}` : '';\n  \n  // Фото\n  let mediaUrl = '';\n  const imgMatch = postHtml.match(/background-image:url\\(['\"]?([^'\"\\)]+)['\"]?\\)/i);\n  if (imgMatch) mediaUrl = imgMatch[1];\n  \n  if (text && text.length > 20) {\n    items.push({\n      title: text.substring(0, 100),\n      link,\n      description: text.substring(0, 1000),\n      pubDate,\n      mediaUrl,\n      source_id: $('Читаем источники').first().json.id,\n      source_name: $('Читаем источники').first().json.name\n    });\n  }\n}\n\nreturn items.map(item => ({ json: item }));"
      },
      "id": "9e6819b7-4961-4748-9a21-22c29439c6f2",
      "name": "Parse Telegram",
      "type": "n8n-nodes-base.code",
