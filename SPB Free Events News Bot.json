    {
      "parameters": {
        "jsCode": "// Извлекаем текст поста из ответа LLM\nconst input = $input.first().json;\nconst originalData = $('Готовим промт').first().json;\n\nlet postText = '';\nif (input.message && input.message.content) {\n  postText = input.message.content;\n} else if (input.text) {\n  postText = input.text;\n} else if (typeof input === 'string') {\n  postText = input;\n}\n\n// Очищаем от возможных markdown блоков\npostText = postText.replace(/```[\\s\\S]*?```/g, '').trim();\n\nreturn [{\n  json: {\n    post_text: postText,\n    media_url: originalData.mediaUrl || '',\n    content_hash: originalData.content_hash,\n    title: originalData.title,\n    link: originalData.link,\n    source_id: originalData.source_id,\n    settings: originalData.settings\n  }\n}];"
